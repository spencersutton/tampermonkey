{
  "name": "tampermonkey",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "npm run lint && tsc --noEmit && vite build",
    "test": "node --test",
    "test:server": "uv run --project server python -m unittest discover -s server/tests",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "oxlint": "^1.92.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "htmx.org": "^2.0.8"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
