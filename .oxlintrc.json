{
    "ignorePatterns": ["tests/**"],
    "options": {
        "typeAware": true
    },
    "rules": {
        "typescript/no-unnecessary-condition": "error",
        "no-implicit-coercion": [
            "error",
            {
                "boolean": true,
                "number": false,
                "string": false
            }
        ],
        "no-empty": "error"
    }
}