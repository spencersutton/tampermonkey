#!/bin/sh
# Runs `ruff format` on the Python files in this commit and re-stages them.
# Enable once per clone with: git config core.hooksPath githooks

RUFF=$(command -v ruff || true)
if [ -z "$RUFF" ]; then
    echo "pre-commit: ruff not found on PATH; skipping formatting. Install it with: pipx install ruff" >&2
    exit 0
fi

files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.py')
[ -n "$files" ] || exit 0

echo "$files" | xargs "$RUFF" format --force-exclude
status=$?
if [ $status -ne 0 ]; then
    echo "pre-commit: ruff format failed" >&2
    exit $status
fi

echo "$files" | xargs git add --
