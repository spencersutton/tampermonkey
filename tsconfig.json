{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["vite/client"],
    // Modules swapped per build (see vite.config.ts); type-checked against the userscript's.
    "paths": {
      "@source": ["./src/app/source-local.tsx"],
      "@auth": ["./src/app/auth-site.tsx"],
      "@storage": ["./src/app/storage-gm.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
