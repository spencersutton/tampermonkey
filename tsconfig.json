{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["vite/client"],
    // The standalone build's catalog source; the server build swaps in source-server.tsx (see vite.config.ts).
    "paths": { "@source": ["./src/app/source-local.tsx"] }
  },
  "include": ["src", "vite.config.ts"]
}
